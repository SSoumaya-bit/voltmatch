# ── Stripe ──────────────────────────────────────────
# Clé secrète (Dashboard → Developers → API Keys)
# Commence par sk_test_ pour les tests, sk_live_ en production
STRIPE_SECRET_KEY=sk_test_REMPLACE_MOI

# Clé publique (pk_test_... ou pk_live_...) — utilisée aussi côté frontend
# Copie-la également dans js/checkout.js (c'est normal, elle est publique)
STRIPE_PUBLISHABLE_KEY=pk_test_REMPLACE_MOI

# Secret du webhook (Dashboard → Developers → Webhooks → Add endpoint → signing secret)
# Pour les tests en local : stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_REMPLACE_MOI

# ── Resend ───────────────────────────────────────────
# Clé API (resend.com → API Keys → Create API Key)
RESEND_API_KEY=re_REMPLACE_MOI

# Adresse expéditrice vérifiée dans Resend (ton domaine ou resend.dev pour les tests)
# Pour les tests : onboarding@resend.dev (domaine Resend, sans vérification)
EMAIL_FROM=VoltMatch <noreply@voltmatch.fr>

# ── Admin ────────────────────────────────────────────
# Email qui reçoit les notifications de nouvelles commandes
ADMIN_EMAIL=REMPLACE_PAR_TON_EMAIL_ADMIN

# ── Serveur ──────────────────────────────────────────
PORT=3000

# URL du frontend (pour la config CORS)
# En dev local : http://localhost:8085 ou http://127.0.0.1:5500
# En production : https://voltmatch.fr (ou ton domaine réel)
CLIENT_ORIGIN=http://localhost:8085
